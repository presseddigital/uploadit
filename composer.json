{
    "name": "presseddigital/uploadit",
    "description": "The unausuming front end asset uploader for Craft 4. Use as a standalone uploader or as field in one of your forms:",
    "type": "craft-plugin",
    "version": "4.0.0",
    "license": "proprietary",
    "support": {
        "email": "hi@pressed.digital",
        "issues": "https://github.com/presseddigital/uploadit/issues?state=open",
        "source": "https://github.com/presseddigital/uploadit",
        "docs": "https://github.com/presseddigital/uploadit",
        "rss": "https://github.com/presseddigital/uploadit/releases.atom"
    },
    "require": {
        "php": ">=8.0.2",
        "craftcms/cms": "^4.11.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "presseddigital\\uploadit\\": "src/"
        }
    },
    "extra": {
        "handle": "uploadit",
        "name": "Uploadit",
        "developer": "Pressed Digital",
        "documentationUrl": "https://github.com/presseddigital/uploadit",
        "class": "presseddigital\\uploadit\\Uploadit"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.0.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}

